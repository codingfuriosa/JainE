# Same project JAIN-E itself talks to -- the publishable anon key, not the service key.
SUPABASE_URL=https://rkxsgtauigjrpcjkmccu.supabase.co
SUPABASE_ANON_KEY=

# From: select value from acc.job_secrets where name = 'sheet_bot';
SHEET_BOT_SECRET=

# Used only for the Aadhaar-disambiguation decision (see src/claude-decision.js).
ANTHROPIC_API_KEY=

# The Sheet this PC appends booking rows to. Use a TEST COPY while getting this running --
# see README.md -- then switch to the real one.
SHEET_URL=https://docs.google.com/spreadsheets/d/1c1h3p-GqjzbgwDjXXIN79Jv9S06GYe10VruPvfLhIWo/edit?gid=0

# Chrome must already be running with --remote-debugging-port=<this>, signed into the
# Google account that has edit access to SHEET_URL. See README.md step 2.
CHROME_DEBUG_PORT=9222

# Safety-net poll, in case a Realtime ping is missed (ms). The ping is what makes this fast;
# this is just the fallback.
POLL_INTERVAL_MS=180000

# Where rotating log files and failure screenshots go. Created if missing.
LOG_DIR=./logs
