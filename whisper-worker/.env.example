# Copy to .env and fill in. Load it before running (e.g. `set -a; . ./.env; set +a` on Linux/mac,
# or use `python-dotenv`), or just set these as real environment variables.

# The whisper-jobs edge function URL (JAIN-E Supabase project):
WHISPER_JOBS_URL=https://rkxsgtauigjrpcjkmccu.supabase.co/functions/v1/whisper-jobs

# Shared secret — must EXACTLY match the WORKER_SECRET you set in Supabase (see README step 2):
WORKER_SECRET=change-me-to-a-long-random-string

# Supabase publishable/anon key (so the edge gateway accepts the request):
SUPABASE_ANON_KEY=sb_publishable_16E3r7KtxA7RMVdtm08gkA_DSEAo94n

# Model + hardware:
WHISPER_MODEL=large-v3      # large-v3 (best) | medium | small (faster, less accurate)
WHISPER_DEVICE=auto         # auto | cuda (GPU) | cpu
# WHISPER_COMPUTE=float16   # optional override; defaults: float16 on GPU, int8 on CPU
POLL_SECONDS=30
JOB_BATCH=3
