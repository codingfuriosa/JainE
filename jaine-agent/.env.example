# Copy this file to .env and fill in the values for this machine.

# --- Identity -----------------------------------------------------------
# Leave blank to auto-generate a stable id on first run (saved to .machine_id
# next to this file). Set it explicitly once you want to name this machine,
# e.g. "Machine A", so a job can later be pinned to it.
MACHINE_ID=

# --- LLM provider ---------------------------------------------------------
# Which LLMProvider implementation to use. Only "ollama" exists so far;
# "anthropic" / "openai" / "gemini" are added later without changing the
# browser-agent code (see jaine_agent/llm/base.py).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Required — no default model is hard-coded. Pull a model with Ollama first,
# e.g. `ollama pull qwen2.5:14b`, then put its name here.
OLLAMA_MODEL=

# --- Supabase (wired up starting Phase 6/7) --------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Worker behaviour -------------------------------------------------------
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# --- Browser (Phase 3+) -----------------------------------------------------
# Chrome 136+ blocks CDP debugging on your normal default profile (security
# fix), so this drives a SEPARATE, dedicated Chrome profile instead — log into
# target apps (FarVision etc.) in it once, by hand, and every automation run
# reuses that same session. Leave blank to use jaine-agent/.chrome-profile.
CHROME_PROFILE_DIR=
# "chrome" drives your real installed Google Chrome; "chromium" uses
# Playwright's bundled Chromium instead if Chrome isn't available.
BROWSER_CHANNEL=chrome
# false = a visible window (needed the first time, to log in by hand).
BROWSER_HEADLESS=false

# --- Safety (Phase 4+) -------------------------------------------------------
# Hard caps so a confused agent can't loop forever or run unattended past a
# sane wall-clock budget. See Section 11 (safety) in the project spec.
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_SECONDS=300
# Only turn on if OLLAMA_MODEL is a vision-capable model (llama3.2-vision, qwen2.5vl, ...) — a
# text-only model gets a hard 400 from Ollama the moment Browser Use sends it a screenshot.
AGENT_USE_VISION=false
